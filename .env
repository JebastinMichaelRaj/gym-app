# Copy this file to .env and fill in real values before running the app.

# Local MongoDB:      mongodb://127.0.0.1:27017/ironform
# MongoDB Atlas:       mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ironform
MONGODB_URI=mongodb://127.0.0.1:27017/ironform

# Port the Express server listens on
PORT=5000

# Secret used to sign JWTs — replace with a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
